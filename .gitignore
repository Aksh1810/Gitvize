# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Jest coverage output
/coverage/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local environment files; allow a placeholder-only root template
.env*
!/.env.example

# vercel
.vercel/

# tooling caches
.eslintcache
.cache/
.turbo/

# editors/ide
.idea/
.vscode/

# typescript
*.tsbuildinfo
next-env.d.ts

# local assistant tooling and working notes
/.docs/
/.gemini/
/.claude/
CLAUDE.md
AGENT_CHANGES.md
docs/ui-ux-research.md
docs/ui-ux-audit.md
